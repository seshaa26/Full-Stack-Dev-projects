# ── Root .gitignore for DevXGen ──────────────────────────────

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Environment variables and credential keys (secrets!)
.env
.env.local
.env.*.local
*.csv
*client_secret*.json
infome.txt
# Keep templates for reference
!.env.production
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS-specific
.DS_Store
Thumbs.db
Desktop.ini

# Editor/IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Docker volumes
docker-data/

# SSL certificates (generated on server)
nginx/certs/
certbot/

# Coverage and testing
coverage/
*.lcov
