# Production environment variables for Oracle Cloud VM deployment
# Copy this file to .env and fill in the values

# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/devxgen?retryWrites=true&w=majority

# JWT Secret (generate with: openssl rand -base64 64)
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_production_google_client_id.apps.googleusercontent.com

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=devxgen-uploads

# Frontend URL (for CORS — must match your Vercel deployment URL)
CLIENT_URL=https://devxgen.in
